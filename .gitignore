# Personal learning context (Devpost Learn) — keep out of commits
/devpost/learner-profile.md

# Local credentials — never commit
.env
.env.*
.env.local
!.env.example

# Dependencies and build output
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Mutable runtime state: trusted history, added documents, pending proposals
/data/runtime/

# Test and tool output
test-results/
playwright-report/
coverage/

# OS / editor noise
.DS_Store
Thumbs.db
*.log

# Real medical documents for private local testing must NEVER live in this folder.
# This rule is a last-resort safety net, not permission to store them here.
/private/

# Logo working files (Illustrator / EPS / PDF sources, which can embed font data) and the local brand kit.
# The app ships only its outlined assets: public/brand/mark.svg and app/icon.svg.
/logo/
/brand/

# Font files never ship (the wordmark's typeface is commercial; app fonts come from next/font)
*.otf
*.ttf
*.cff
*.woff
*.woff2
