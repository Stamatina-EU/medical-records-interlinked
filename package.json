{
  "name": "medical-history",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-linked medical history proof of concept (synthetic data only).",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "test": "vitest run && npm run verify:seed",
    "verify:seed": "tsx scripts/verify-seed.ts",
    "corpus:build": "tsx scripts/build-corpus.ts",
    "preflight": "tsx scripts/preflight.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "verify:rich": "tsx scripts/verify-rich.ts",
    "corpus:rich": "tsx scripts/build-rich-corpus.ts",
    "start:legacy": "tsx scripts/run-profile.ts legacy start",
    "dev:legacy": "tsx scripts/run-profile.ts legacy dev",
    "start:rich": "tsx scripts/run-profile.ts rich start",
    "demo:reset:legacy": "tsx scripts/demo-reset.ts --legacy",
    "demo:reset:rich": "tsx scripts/demo-reset.ts --rich",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "next": "^16.3.6",
    "openai": "^7.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
